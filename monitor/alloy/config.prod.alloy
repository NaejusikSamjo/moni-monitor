// ============================================================
// Grafana Alloy 운영(monitoring-ec2) 설정
// Eureka SD로 service-ec2의 모든 서비스를 동적으로 발견하여
// Prometheus(메트릭) · 모니터링 스택 자체를 감시
//
// 환경변수 (docker-compose.prod.yml 에서 주입):
//   PROMETHEUS_REMOTE_WRITE_URL — Prometheus remote_write 엔드포인트
//   EUREKA_URL                  — Eureka 서버 주소
// ============================================================

// ============================================================
// 1. 메트릭 수집 — Eureka SD로 service-ec2의 모든 서비스 스크래핑
// ============================================================

discovery.eureka "moni" {
  server           = sys.env("EUREKA_URL")
  refresh_interval = "30s"   // 서비스 재배포 시 최대 30초 내 자동 반영
}

// Eureka 메타 레이블 → application / instance 레이블로 정규화
// 서비스가 Docker 내부 IP(172.18.x.x)로 Eureka에 등록되므로 service-EC2 호스트 IP로 교체
discovery.relabel "moni_meta" {
  targets = discovery.eureka.moni.targets

  rule {
    source_labels = ["__meta_eureka_app_name"]
    target_label  = "application"
    action        = "lowercase"
  }
  rule {
    source_labels = ["__meta_eureka_app_instance_id"]
    target_label  = "instance"
  }
  rule {
    target_label = "__host_ip"
    replacement  = sys.env("SERVICE_PRIVATE_IP")
  }
  rule {
    source_labels = ["__host_ip", "__address__"]
    separator     = ";"
    regex         = "([^;]+);[^:]+:([0-9]+)"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }
}

// 전체 메트릭 (60초) — 대시보드 상세용
prometheus.scrape "moni_services" {
  targets         = discovery.relabel.moni_meta.output
  scrape_interval = "60s"
  metrics_path    = "/actuator/prometheus"
  job_name        = "moni-services"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// 헬스 감시 (30초) — up 지표만
prometheus.scrape "moni_health" {
  targets         = discovery.relabel.moni_meta.output
  scrape_interval = "30s"
  metrics_path    = "/actuator/prometheus"
  job_name        = "moni-health"
  forward_to      = [prometheus.relabel.health_filter.receiver]
}

prometheus.relabel "health_filter" {
  rule {
    source_labels = ["__name__"]
    regex         = "up"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.default.receiver]
}

// ============================================================
// 2. 인프라 메트릭 수집 (30초)
// ============================================================

prometheus.scrape "infra_exporters" {
  targets = [
    {"__address__" = "node-exporter:9100",      job = "node-exporter"},
    {"__address__" = "postgres-exporter:9187",  job = "postgresql"},
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// ============================================================
// 3. 모니터링 스택 자체 감시 (30초)
// ============================================================

prometheus.scrape "monitor_stack" {
  targets = [
    {"__address__" = "prometheus:9090",   job = "monitor-stack"},
    {"__address__" = "loki:3100",         job = "monitor-stack"},
    {"__address__" = "tempo:3200",        job = "monitor-stack"},
    {"__address__" = "grafana:3000",      job = "monitor-stack"},
    {"__address__" = "alertmanager:9093", job = "monitor-stack"},
    {"__address__" = "alloy:12345",       job = "monitor-stack"},
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")

    queue_config {
      capacity             = 10000
      max_samples_per_send = 2000
      batch_send_deadline  = "10s"
      max_shards           = 10
    }
  }

  external_labels = {
    environment = "prod",
  }
}
