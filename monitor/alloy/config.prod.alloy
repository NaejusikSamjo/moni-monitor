// ============================================================
// Grafana Alloy 운영(monitoring-ec2) 설정
// 인프라 메트릭 + 모니터링 스택 자체 감시 담당
// 서비스 메트릭은 service-ec2 사이드카 Alloy가 scrape 후 remote_write
//
// 환경변수 (docker-compose.prod.yml 에서 주입):
//   PROMETHEUS_REMOTE_WRITE_URL — Prometheus remote_write 엔드포인트
//   SERVICE_PRIVATE_IP          — service-ec2 private IP
//   INFRA_PRIVATE_IP            — infra-ec2 private IP
// ============================================================

// ============================================================
// 1. 인프라 메트릭 수집 (30초)
// ============================================================

prometheus.scrape "infra_exporters" {
  targets = [
    {"__address__" = "node-exporter:9100",                          job = "node-exporter", instance_name = "monitor-ec2"},
    {"__address__" = sys.env("SERVICE_PRIVATE_IP") + ":9100",      job = "node-exporter", instance_name = "service-ec2"},
    {"__address__" = sys.env("INFRA_PRIVATE_IP") + ":9100",        job = "node-exporter", instance_name = "infra-ec2"},
    {"__address__" = "postgres-exporter:9187",                      job = "postgresql"},
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

// ============================================================
// 2. 모니터링 스택 자체 감시 (30초)
// ============================================================

prometheus.scrape "monitor_stack" {
  targets = [
    {"__address__" = "prometheus:9090",   job = "monitor-stack"},
    {"__address__" = "loki:3100",         job = "monitor-stack"},
    {"__address__" = "tempo:3200",        job = "monitor-stack"},
    {"__address__" = "grafana:3000",      job = "monitor-stack"},
    {"__address__" = "alertmanager:9093", job = "monitor-stack"},
    {"__address__" = "alloy:12345",       job = "monitor-stack"},
  ]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")

    queue_config {
      capacity             = 10000
      max_samples_per_send = 2000
      batch_send_deadline  = "10s"
      max_shards           = 10
    }
  }

  external_labels = {
    environment = "prod",
  }
}
