// ============================================================
// Grafana Alloy 운영(사이드카) 설정
// 각 서비스 EC2 서버에 단독 배포하여 해당 서버의 로그·메트릭을
// 중앙 모니터링 서버(Loki / Prometheus)로 전송
//
// 환경변수 (docker-compose.alloy.yml 에서 주입):
//   LOKI_URL                  — 모니터링 서버의 Loki push 엔드포인트
//   PROMETHEUS_REMOTE_WRITE_URL — 모니터링 서버의 Prometheus remote_write 엔드포인트
//   EUREKA_URL                — 유레카 서버 주소
//   HOST_NAME                 — 이 서버의 식별자 (예: user-service-ec2)
// ============================================================

// ============================================================
// 1. 로그 수집 — /var/log/services/<service>/*.log
// ============================================================

loki.source.file "moni_services" {
  targets = [
    {__path__ = "/var/log/services/**/*.log", job = "moni"},
  ]
  forward_to = [loki.process.filter.receiver]
}

loki.process "filter" {
  stage.regex {
    source     = "filename"
    expression = "/var/log/services/(?P<service>[^/]+)/"
  }
  stage.labels {
    values = {service = "service"}
  }

  stage.json {
    expressions = {level = "level"}
  }
  stage.labels {
    values = {level = "level"}
  }

  // 운영: INFO 이하 drop (ERROR / WARN 만 보존)
  stage.drop {
    source     = "level"
    expression = "(?i)^(info|debug|trace)$"
  }

  // host 레이블 추가 (어느 서버에서 온 로그인지 식별)
  stage.static_labels {
    values = {host = sys.env("HOST_NAME")}
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL")

    // 배치 전송 설정 (네트워크 비용 절감)
    batch_size  = 1048576    // 1 MiB
    batch_wait  = "10s"
  }

  external_labels = {
    host        = sys.env("HOST_NAME"),
    environment = "prod",
  }
}

// ============================================================
// 2. 메트릭 수집 — Eureka SD로 이 서버에 뜬 서비스만 스크래핑
// ============================================================

discovery.eureka "moni" {
  server           = sys.env("EUREKA_URL")
  refresh_interval = "30s"
}

// 이 서버(HOST_NAME)에서 실행 중인 인스턴스만 필터링
discovery.relabel "moni_local" {
  targets = discovery.eureka.moni.targets

  rule {
    source_labels = ["__meta_eureka_app_name"]
    target_label  = "application"
    action        = "lowercase"
  }
  rule {
    source_labels = ["__meta_eureka_app_instance_hostname"]
    target_label  = "instance_hostname"
  }

  // 이 호스트의 인스턴스만 유지
  rule {
    source_labels = ["__meta_eureka_app_instance_hostname"]
    regex         = sys.env("HOST_NAME")
    action        = "keep"
  }
}

// 헬스 (30초) — up 지표만
prometheus.scrape "moni_health" {
  targets         = discovery.relabel.moni_local.output
  scrape_interval = "30s"
  metrics_path    = "/actuator/prometheus"
  job_name        = "moni-health"
  forward_to      = [prometheus.relabel.health_filter.receiver]
}

prometheus.relabel "health_filter" {
  rule {
    source_labels = ["__name__"]
    regex         = "up"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.default.receiver]
}

// HTTP + HikariCP 신호 (60초)
prometheus.scrape "moni_signals" {
  targets         = discovery.relabel.moni_local.output
  scrape_interval = "60s"
  metrics_path    = "/actuator/prometheus"
  job_name        = "moni-signals"
  forward_to      = [prometheus.relabel.signals_filter.receiver]
}

prometheus.relabel "signals_filter" {
  rule {
    source_labels = ["__name__"]
    regex         = "http_server_requests_seconds_(bucket|count|sum)|hikaricp_connections_(active|pending|max|min)"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.default.receiver]
}

// JVM 메트릭 (5분)
prometheus.scrape "moni_jvm" {
  targets         = discovery.relabel.moni_local.output
  scrape_interval = "300s"
  metrics_path    = "/actuator/prometheus"
  job_name        = "moni-jvm"
  forward_to      = [prometheus.relabel.jvm_filter.receiver]
}

prometheus.relabel "jvm_filter" {
  rule {
    source_labels = ["__name__"]
    regex         = "jvm_memory_(used|max|committed)_bytes|jvm_gc_pause_seconds_(bucket|count|sum)|jvm_threads_(live|daemon|peak)_threads|process_cpu_usage"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.default.receiver]
}

// 전체 메트릭 (60초 — 대시보드 상세용)
prometheus.scrape "moni_services" {
  targets         = discovery.relabel.moni_local.output
  scrape_interval = "60s"
  metrics_path    = "/actuator/prometheus"
  job_name        = "moni-services"
  forward_to      = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("PROMETHEUS_REMOTE_WRITE_URL")

    queue_config {
      capacity             = 10000
      max_samples_per_send = 2000
      batch_send_deadline  = "10s"
      max_shards           = 10
    }
  }

  external_labels = {
    host        = sys.env("HOST_NAME"),
    environment = "prod",
  }
}
