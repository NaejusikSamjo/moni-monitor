{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "moni 분산 추적 + 로그 탐색 통합 — 서비스 맵, Span 레이턴시, Trace 검색, 로그 스트림, trace_id ↔ Tempo 연동",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "서비스 의존성 맵",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": { "edges": {}, "nodes": {} },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": "{}"
        }
      ],
      "title": "서비스 의존성 맵 (Tempo service graph)",
      "type": "nodeGraph"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Span 레이턴시 & 요청률",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 2,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p50 {{service}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p95 {{service}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p99 {{service}}",
          "refId": "C"
        }
      ],
      "title": "Span 레이턴시 (p50 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 3,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) by (service)",
          "legendFormat": "에러 {{service}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\"}[$__rate_interval])) by (service)",
          "legendFormat": "전체 {{service}}",
          "refId": "B"
        }
      ],
      "title": "Span 요청률 (전체 vs 에러)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Trace 검색",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 23 },
      "id": 4,
      "options": { "dedupStrategy": "none" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "filters": [
            { "id": "service-name", "operator": "=~", "scope": "resource", "tag": "service.name", "value": "$service", "valueType": "string" }
          ],
          "limit": 20,
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces",
          "query": "{resource.service.name=~\"$service\" && duration > $min_duration}"
        }
      ],
      "title": "Trace 목록 (서비스 / 최소 지속시간 필터)",
      "type": "table"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 37 },
      "id": 5,
      "options": { "dedupStrategy": "none" },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces",
          "query": "{resource.service.name=~\"$service\" && status = error}"
        }
      ],
      "title": "에러 Trace 목록 (status=error)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 47 },
      "id": 103,
      "title": "로그 볼륨 & 집계",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 20 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [{ "id": "color", "value": { "fixedColor": "red",    "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "WARN"  }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 48 },
      "id": 6,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (level) (count_over_time({job=\"moni\", service=~\"$service\"} | json | level=~\"$level\" [$__auto]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "title": "로그 볼륨 (레벨별)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 56 },
      "id": 7,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"moni\", service=~\"$service\", level=\"ERROR\"} [$__range]))",
          "legendFormat": "ERROR 건수",
          "refId": "A"
        }
      ],
      "title": "ERROR 총 건수",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "orange", "value": 20 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 56 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"moni\", service=~\"$service\", level=\"WARN\"} [$__range]))",
          "legendFormat": "WARN 건수",
          "refId": "A"
        }
      ],
      "title": "WARN 총 건수",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (service) (count_over_time({job=\"moni\", level=\"ERROR\"} [$__range]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "서비스별 ERROR 분포",
      "type": "piechart"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 },
      "id": 104,
      "title": "로그 스트림 (trace_id → Tempo 드릴다운)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 65 },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"moni\", service=~\"$service\"} | json | level=~\"$level\" | line_format \"[{{.level}}] {{.service}} — {{.message}} (trace={{.trace_id}})\"",
          "refId": "A"
        }
      ],
      "title": "로그 스트림 (trace_id 클릭 → Tempo 이동)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["moni", "tracing", "logs", "tempo", "loki"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "service",
        "options": [
          { "selected": true,  "text": "전체",                "value": ".*"                  },
          { "selected": false, "text": "user-service",         "value": "user-service"         },
          { "selected": false, "text": "trade-service",        "value": "trade-service"        },
          { "selected": false, "text": "stock-service",        "value": "stock-service"        },
          { "selected": false, "text": "portfolio-service",    "value": "portfolio-service"    },
          { "selected": false, "text": "notification-service", "value": "notification-service" },
          { "selected": false, "text": "payment-service",      "value": "payment-service"      },
          { "selected": false, "text": "ai-service",           "value": "ai-service"           },
          { "selected": false, "text": "admin-service",        "value": "admin-service"        }
        ],
        "query": ".*,user-service,trade-service,stock-service,portfolio-service,notification-service,payment-service,ai-service,admin-service",
        "type": "custom",
        "label": "서비스"
      },
      {
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "level",
        "options": [
          { "selected": true,  "text": "All",   "value": "$__all" },
          { "selected": false, "text": "ERROR",  "value": "ERROR"  },
          { "selected": false, "text": "WARN",   "value": "WARN"   },
          { "selected": false, "text": "INFO",   "value": "INFO"   },
          { "selected": false, "text": "DEBUG",  "value": "DEBUG"  }
        ],
        "query": "ERROR,WARN,INFO,DEBUG",
        "type": "custom",
        "label": "로그 레벨"
      },
      {
        "current": { "selected": true, "text": "0ms", "value": "0ms" },
        "hide": 0,
        "name": "min_duration",
        "options": [
          { "selected": true,  "text": "0ms",  "value": "0ms"  },
          { "selected": false, "text": "100ms", "value": "100ms" },
          { "selected": false, "text": "500ms", "value": "500ms" },
          { "selected": false, "text": "1s",    "value": "1s"    },
          { "selected": false, "text": "5s",    "value": "5s"    }
        ],
        "query": "0ms,100ms,500ms,1s,5s",
        "type": "custom",
        "label": "최소 Span 시간"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Trace & Log Explorer",
  "uid": "moni-trace-log",
  "version": 1
}
