      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"moni-services\", application=~\"$application\", outcome=\"SERVER_ERROR\"}[1m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"moni-services\", application=~\"$application\"}[1m])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "title": "HTTP 에러율 (5xx)",
      "type": "timeseries"
