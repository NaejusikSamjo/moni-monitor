{
  "uid": "spring-boot-observability",
  "title": "Observability",
  "description": "메트릭(Prometheus) · 로그(Loki) · 트레이스(Tempo) 통합 — Grafana Labs 커뮤니티 대시보드 17175 기반",
  "tags": ["spring-boot", "moni", "observability"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "서비스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(up{job=\"moni-health\"}, application)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "서비스 상태 (UP=1 / DOWN=0)",
      "description": "moni-health job 기준 서비스 생존 여부",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=\"moni-health\", application=~\"$application\"}",
          "legendFormat": "{{application}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "HTTP",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "title": "HTTP 요청률 (RPS)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"moni-services\", application=~\"$application\"}[$__rate_interval])) by (application)",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 에러율 (5xx %)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"moni-services\", application=~\"$application\", status=~\"5..\"}[$__rate_interval])) by (application) / sum(rate(http_server_requests_seconds_count{job=\"moni-services\", application=~\"$application\"}[$__rate_interval])) by (application)",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 레이턴시 (평균 / 최대)",
      "description": "Spring Boot Actuator가 histogram bucket을 미노출하므로 avg=sum/count, max=seconds_max 로 표시",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (application) (rate(http_server_requests_seconds_sum{job=\"moni-services\", application=~\"$application\"}[$__rate_interval])) / sum by (application) (rate(http_server_requests_seconds_count{job=\"moni-services\", application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "avg {{application}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (application) (http_server_requests_seconds_max{job=\"moni-services\", application=~\"$application\"})",
          "legendFormat": "max {{application}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 20,
      "title": "JVM",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 }
    },
    {
      "id": 5,
      "title": "JVM Heap 사용량",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_used_bytes{job=\"moni-services\", application=~\"$application\", area=\"heap\"}) by (application)",
          "legendFormat": "{{application}} used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_max_bytes{job=\"moni-services\", application=~\"$application\", area=\"heap\"}) by (application)",
          "legendFormat": "{{application}} max",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "CPU 사용률",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_cpu_usage{job=\"moni-services\", application=~\"$application\"}",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "JVM 스레드",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_live_threads{job=\"moni-services\", application=~\"$application\"}",
          "legendFormat": "{{application}} live",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "title": "로그 (Loki)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 }
    },
    {
      "id": 8,
      "title": "서비스 로그 스트림",
      "description": "ERROR/WARN/INFO 로그. trace_id 클릭 시 Tempo로 이동",
      "type": "logs",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 12 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"moni\", service=~\"$application\"} | json | level =~ \"(?i)(error|warn|info)\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 40,
      "title": "분산 추적 (Tempo)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 }
    },
    {
      "id": 9,
      "title": "Span 레이턴시 (traces_spanmetrics)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 16, "h": 8 },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_latency_bucket{service=~\"$application\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p99 {{service}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_latency_bucket{service=~\"$application\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p50 {{service}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "Trace 검색",
      "description": "서비스·operation·duration으로 트레이스 검색. 클릭 시 상세 보기",
      "type": "traces",
      "gridPos": { "x": 16, "y": 36, "w": 8, "h": 8 },
      "options": {},
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$application\"}",
          "limit": 20,
          "refId": "A"
        }
      ]
    }
  ]
}
