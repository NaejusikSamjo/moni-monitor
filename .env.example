# ============================================================
# monitoring/ 환경변수 가이드
#
# 환경별로 전용 파일을 사용하세요:
#
#   로컬 개발  → cp .env.local.example .env
#   운영 배포  → cp .env.prod.example  .env.prod
#
# 이 파일은 참고용 전체 변수 목록입니다.
# ============================================================

# ── 공통 (로컬/운영 모두 필요) ──────────────────────────────

# 서비스 EC2 IP (로컬: host.docker.internal, 운영: Private IP)
SERVICE_PRIVATE_IP=

# Eureka 포트
EUREKA_PORT=8761

# 서비스 로그 경로 (Alloy가 마운트해 Loki 전송)
# 로컬: ../moni/logs  |  운영: /var/log/moni
LOG_PATH=

# 모니터링 스택 포트
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_GRPC_PORT=4317
GRAFANA_PORT=3000

# Grafana 관리자 계정
# 로컬: admin/admin  |  운영: Okta SSO 사용 (GF_AUTH_DISABLE_LOGIN_FORM=true)
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=

# Discord 알림 웹훅
DISCORD_WEBHOOK_URL=
DISCORD_CRITICAL_WEBHOOK_URL=

# ── 운영 전용 (.env.prod 에서만 사용) ────────────────────────

# AWS S3 (Loki/Tempo 데이터 저장)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOKI_S3_BUCKET=
LOKI_S3_PREFIX=
TEMPO_S3_BUCKET=
TEMPO_S3_PREFIX=

# Okta SSO (운영 Grafana 로그인)
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_AUTH_URL=
OKTA_TOKEN_URL=
OKTA_API_URL=
